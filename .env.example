# Copy this file to .env and fill in real values. Never commit .env.
# Web app: where the sync server lives.
VITE_SYNC_URL=ws://localhost:1234
# Sync server: the port it listens on.
SYNC_PORT=1234
# Sync server: secret used to sign and verify JWTs.
# Change this before any shared deployment.
JWT_SECRET=change-me-in-production
# Sync server: SQLite file for persisted board state (Phase 4).
DATABASE_URL=file:./data/syncboard.db
