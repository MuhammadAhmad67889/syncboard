{
  "description": "SyncBoard — a real-time collaborative whiteboard (Miro/FigJam-style shared canvas with sticky notes).",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "syncboard",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace=@syncboard/shared && npm run build --workspaces --if-present",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "dev:server": "npm run dev --workspace=@syncboard/sync-server",
    "dev:web": "npm run dev --workspace=@syncboard/web",
    "lint": "eslint . --max-warnings 0",
    "pretest": "npm run build --workspace=@syncboard/shared",
    "pretypecheck": "npm run build --workspace=@syncboard/shared",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
